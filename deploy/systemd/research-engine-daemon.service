[Unit]
Description=Research Engine 24/7 Agentic Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/adamArchives/Adam/research-engine
EnvironmentFile=%h/adamArchives/Adam/.research-engine/research-engine.env
Environment=RESEARCH_ENGINE_SEMANTIC_BACKEND=codex
Environment=RESEARCH_ENGINE_DATABASE_URL=postgresql://research_engine:research_engine@localhost:5432/research_engine
Environment=RESEARCH_ENGINE_ARTIFACT_ROOT=%h/adamArchives/Adam/.research-engine/artifacts
ExecStart=%h/adamArchives/Adam/.research-engine/venv/bin/research-engine daemon
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true

[Install]
WantedBy=default.target
