# Copy to a private host-only environment file. Never commit credentials.
OPENAI_API_KEY=

# Optional worker concurrency overrides.
RESEARCH_ENGINE_DETERMINISTIC_WORKERS=2
RESEARCH_ENGINE_CHEAP_WORKERS=4
RESEARCH_ENGINE_STANDARD_WORKERS=2
RESEARCH_ENGINE_STRONG_WORKERS=1

# Optional model routing overrides.
RESEARCH_ENGINE_OPENAI_CHEAP_MODEL=gpt-5.6-luna
RESEARCH_ENGINE_OPENAI_CHEAP_EFFORT=low
RESEARCH_ENGINE_OPENAI_STANDARD_MODEL=gpt-5.6-terra
RESEARCH_ENGINE_OPENAI_STANDARD_EFFORT=medium
RESEARCH_ENGINE_OPENAI_STRONG_MODEL=gpt-5.6-sol
RESEARCH_ENGINE_OPENAI_STRONG_EFFORT=high

# Daemon supervision.
RESEARCH_ENGINE_POLL_SECONDS=2
RESEARCH_ENGINE_LEASE_SECONDS=300
RESEARCH_ENGINE_MAX_ACTIVE_RUNS=4
RESEARCH_ENGINE_MAX_PENDING_HUMAN=8
RESEARCH_ENGINE_STALE_WORKER_SECONDS=900

# Native/systemd deployment only; Compose supplies these internally.
RESEARCH_ENGINE_DATABASE_URL=postgresql://research_engine:research_engine@localhost:5432/research_engine
RESEARCH_ENGINE_ARTIFACT_ROOT=%h/adamArchives/Adam/.research-engine/artifacts
