# Production host configuration for ChatGPT-authenticated Codex.
# No OPENAI_API_KEY belongs in this file.

RESEARCH_ENGINE_SEMANTIC_BACKEND=codex

# Set this to the exact result of: command -v codex
RESEARCH_ENGINE_CODEX_BIN=/absolute/path/to/codex

# Conservative first-acceptance worker concurrency.
RESEARCH_ENGINE_DETERMINISTIC_WORKERS=1
RESEARCH_ENGINE_CHEAP_WORKERS=1
RESEARCH_ENGINE_STANDARD_WORKERS=1
RESEARCH_ENGINE_STRONG_WORKERS=1

# Codex model routing. These requests use the signed-in ChatGPT/Codex plan.
RESEARCH_ENGINE_CODEX_CHEAP_MODEL=gpt-5.6-luna
RESEARCH_ENGINE_CODEX_CHEAP_EFFORT=low
RESEARCH_ENGINE_CODEX_STANDARD_MODEL=gpt-5.6-terra
RESEARCH_ENGINE_CODEX_STANDARD_EFFORT=medium
RESEARCH_ENGINE_CODEX_STRONG_MODEL=gpt-5.6-sol
RESEARCH_ENGINE_CODEX_STRONG_EFFORT=high

# VERIFY receives only evidence-cited source pages by default.
# Increase to 1 to include each cited page plus adjacent pages if quality testing requires it.
RESEARCH_ENGINE_VERIFY_PAGE_RADIUS=0

# Validated shared local document-inference broker.
# Runtime/model-cache paths use the defaults under ~/.research-engine.
# Formula and table owners are long-lived, isolated processes shared by all
# deterministic workers; each model family has a bounded FIFO queue.
RESEARCH_ENGINE_LOCAL_INFERENCE_ENABLED=1
RESEARCH_ENGINE_LOCAL_INFERENCE_MAX_PENDING=8
RESEARCH_ENGINE_LOCAL_INFERENCE_TIMEOUT_SECONDS=900
RESEARCH_ENGINE_FORMULA_GPU_INDEX=0
RESEARCH_ENGINE_TABLE_GPU_INDEX=1

# Derived document sidecar integration. This never replaces authoritative-PDF
# semantic hydration; it compiles/cache routes only after authoritative ACQUIRE.
RESEARCH_ENGINE_DOCUMENT_SIDECAR_ENABLED=1
RESEARCH_ENGINE_DOCUMENT_SIDECAR_SPECIALIZED_ENABLED=1
RESEARCH_ENGINE_DOCUMENT_STRUCTURE_GPU_INDEX=0

RESEARCH_ENGINE_CODEX_TIMEOUT_SECONDS=900
# Fallback backoff when Codex reports a plan limit without a reset duration.
RESEARCH_ENGINE_CODEX_PLAN_LIMIT_RETRY_SECONDS=3600

# Daemon supervision.
RESEARCH_ENGINE_POLL_SECONDS=2
RESEARCH_ENGINE_LEASE_SECONDS=300
RESEARCH_ENGINE_MAX_ACTIVE_RUNS=1
RESEARCH_ENGINE_MAX_PENDING_HUMAN=2
RESEARCH_ENGINE_STALE_WORKER_SECONDS=900

# The native systemd unit supplies DATABASE_URL and ARTIFACT_ROOT directly.
