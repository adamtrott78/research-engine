      "current_version": "2.131.0",
      "version_constraint": "docling==2.131.0",
      "python": ">=3.10,<4.0",
      "install": "python -m pip install 'docling==2.131.0'",
      "executable": "docling",
      "executable_env": "RESEARCH_ENGINE_DOCLING_BIN",
      "version_probe": [
        "--version"
