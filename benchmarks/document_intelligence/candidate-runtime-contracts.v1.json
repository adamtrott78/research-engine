        "source": "https://github.com/docling-project/docling/blob/main/packages/docling/pyproject.toml"
      },
      "modes": {
        "native": {
          "class": "DETERMINISTIC_LOCAL",
          "command": [
            "{bin}",
            "{source}",
            "--from",
            "pdf",
            "--to",
            "md",
            "--to",
            "json",
            "--output",
            "{output_dir}",
            "--pipeline",
            "native"
          ],
          "model_inference": false,
          "expected_outputs": [
            "{source_stem}.md",
            "{source_stem}.json"
          ]
        },
        "standard": {
          "class": "SPECIALIZED_LOCAL_MODEL",
          "command": [
            "{bin}",
            "{source}",
            "--from",
            "pdf",
            "--to",
            "md",
            "--to",
            "json",
            "--output",
            "{output_dir}",
            "--pipeline",
            "standard"
          ],
          "model_inference": true,
          "expected_outputs": [
            "{source_stem}.md",
            "{source_stem}.json"
          ]
        },
        "vlm": {
          "class": "GENERAL_LOCAL_MODEL",
          "command": [
            "{bin}",
            "{source}",
            "--from",
            "pdf",
            "--to",
            "md",
            "--to",
            "json",
            "--output",
            "{output_dir}",
            "--pipeline",
            "vlm"
          ],
          "model_inference": true,
          "expected_outputs": [
            "{source_stem}.md",
            "{source_stem}.json"
          ]
        }
      },
      "capabilities": [
        "markdown",
        "structured_json",
        "layout",
        "tables",
        "ocr",
        "page_provenance",
        "batching"
      ],
      "runtime_notes": "CLI supports standard, VLM, and native PDF pipelines. Keep model cache outside Git."
