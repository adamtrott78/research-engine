{
  "schema_version": 1,
  "title": "Research-engine localization matrix v1",
  "principle": "Localize repetitive deterministic or bounded semantic work when measured quality/provenance is preserved and throughput/plan usage improves; retain external web access and strong remote reasoning where locality adds risk without demonstrated benefit.",
  "entries": [
    {
      "component": "source_discovery_web_search",
      "current_role": "DISCOVERY/NOVELTY_SEARCH external retrieval",
      "target_class": "EXTERNAL_WEB",
      "localize": "partial",
      "localizable_parts": [
        "query expansion",
        "result deduplication",
        "ranking",
        "screening"
      ],
      "retain_external": [
        "internet search/retrieval",
        "freshness-sensitive source access"
      ],
      "benchmark_required": true,
      "authority": "external source records",
      "fallback": "existing web-backed discovery path"
    },
    {
      "component": "source_acquisition_transport",
      "current_role": "download/fetch source bytes",
      "target_class": "DETERMINISTIC_LOCAL",
      "localize": "yes",
      "localizable_parts": [
        "download validation",
        "media sniffing",
        "hashing",
        "deduplication",
        "artifact storage"
      ],
      "benchmark_required": false,
      "authority": "content-addressed source artifact",
      "fallback": "existing acquisition path"
    },
    {
